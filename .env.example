# =====================================================================
# 环境变量示例文件（graduation-design）
# 用法：复制为 .env 并填写真实值；.env 已被 .gitignore 排除，切勿提交。
#   PowerShell:  Copy-Item .env.example .env
# 说明：本项目当前代码不依赖 python-dotenv，请在 shell 中显式设置变量后再运行脚本。
#   PowerShell:  $env:OPENAI_API_KEY = "sk-..."
# =====================================================================

# ---- 本地模型 API（自建推理服务，OpenAI 兼容协议）----
# Base URL（对应 /v1/chat/completions）
LOCAL_LLM_BASE_URL=
# 鉴权密钥（自建服务用请求头 x-api-key 传递）
LOCAL_LLM_API_KEY=
# 模型 ID
LOCAL_LLM_MODEL=
# 自定义请求头名（默认 x-api-key，可按服务要求调整）
LOCAL_LLM_AUTH_HEADER=x-api-key

# ---- 小米 MiMo API（Xiaomi MiMo 开放平台，OpenAI 兼容协议）----
# Base URL（按量付费 https://api.xiaomimimo.com/v1；Token Plan 用专属 Base URL）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# API Key（格式 sk-xxxxx，控制台创建：https://platform.xiaomimimo.com/#/console/api-keys）
MIMO_API_KEY=
# 模型 ID（如 mimo-v2.6-pro）
MIMO_MODEL=

# ---- 通用 / 数据集下载 ----
# Hugging Face 访问令牌（下载受限模型或数据集时需要；公开资源不需要）
HF_TOKEN=

# ---- 大语言模型 API（仅 chinese-skillspan-benchmark 中的 LLM 标注/推理脚本使用）----
# 通用 OpenAI 兼容接口密钥
OPENAI_API_KEY=
# 多密钥轮换（逗号分隔，可留空）
OPENAI_API_KEYS=
# 标注流水线专用密钥（缺失时回退到 OPENAI_API_KEY）
GOLDSTYLE_API_KEY=
# 第三方代理服务密钥（fill_claude_* / pilot_gpt4o_* 等脚本使用）
YSAIKEJI_API_KEY=
# Moonshot / Kimi 密钥（也可写入 ~/.config/moonshot/api_key）
MOONSHOT_API_KEY=

# ---- Chinese-SkillSpan 论文图表渲染（仅 reproduction/ 下绘图脚本使用）----
# 论文工程根目录
CNSS_PAPER_ROOT=
# 中文 / 英文字体文件路径（.ttf / .otf）
CNSS_CN_FONT=
CNSS_EN_FONT=
CNSS_EN_BOLD=

# ---- 训练相关（可选）----
# 限制可见 GPU；不设置则默认使用全部 GPU
# CUDA_VISIBLE_DEVICES=0
# Hugging Face 离线模式：已下载全部模型后可设为 1 避免联网
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# =========================================================
# Phase8-A: OAuth 2.0 统一第三方登录（微信 / QQ / 微博）
# 说明见 docs/oauth/environment-configuration.md
# =========================================================

# 全局开关：缺少真实凭据时保持关闭（false 时任何平台不发起真实授权）
JM_OAUTH_ENABLED=false

# 后端对外公开 HTTPS 地址（回调域名基址，例如 https://api.example.com）
JM_OAUTH_PUBLIC_BASE_URL=

# 前端允许的 Origin（逗号分隔可多个，首个为主；用于票据交换 CSRF 校验与完成页跳转）
JM_OAUTH_FRONTEND_ORIGIN=

# OAuth 会话配置（授权事务 / 一次性票据 TTL，秒）
JM_OAUTH_STATE_TTL_SECONDS=300
JM_OAUTH_TICKET_TTL_SECONDS=60

# ---- 微信开放平台 · 网站应用（PC 扫码，scope=snsapi_login）----
JM_OAUTH_WECHAT_ENABLED=false
JM_OAUTH_WECHAT_CLIENT_ID=
JM_OAUTH_WECHAT_CLIENT_SECRET=
JM_OAUTH_WECHAT_REDIRECT_URI=
# 真实扫码授权联调通过后人工置 true（凭据齐全 != 审核通过 != 联调通过）
JM_OAUTH_WECHAT_VERIFIED=false

# ---- QQ 互联 · 网站应用 ----
JM_OAUTH_QQ_ENABLED=false
JM_OAUTH_QQ_CLIENT_ID=
JM_OAUTH_QQ_CLIENT_SECRET=
JM_OAUTH_QQ_REDIRECT_URI=
JM_OAUTH_QQ_VERIFIED=false

# ---- 微博开放平台 · 网站应用 ----
JM_OAUTH_WEIBO_ENABLED=false
JM_OAUTH_WEIBO_CLIENT_ID=
JM_OAUTH_WEIBO_CLIENT_SECRET=
JM_OAUTH_WEIBO_REDIRECT_URI=
JM_OAUTH_WEIBO_VERIFIED=false
