{
  "data": {
    "gold_holdout": "data/splits/education/gold_holdout.csv",
    "inputs": "data/processed/education/education_inputs.csv",
    "labels": "data/processed/education/education_labels.csv",
    "train": "data/splits/education/train.csv",
    "validation": "data/splits/education/validation.csv"
  },
  "inference": {
    "requires_labels": false,
    "supports_cpu": true
  },
  "model": {
    "architecture": {
      "dropout": 0.1,
      "embedding_dim": 32,
      "kernel_size": 3,
      "n_filters": 64
    },
    "checkpoint": {
      "keep_best": true,
      "mode": "min",
      "monitor": "val_loss"
    },
    "class_weight": "pos_weight",
    "input_field": "slot_education_norm",
    "loss": "bce_with_logits",
    "name": "education_charcnn",
    "params": {
      "batch_size": 512,
      "early_stopping_monitor": "val_loss",
      "early_stopping_patience": 5,
      "epochs": 30,
      "grad_finite_check": true,
      "learning_rate": 0.001,
      "weight_decay": 0.0001
    },
    "sample_weight_strategy_grid": [
      "none",
      "slot_balanced",
      "conflict_aware"
    ],
    "selection_metric": "micro_f1_on_validation",
    "subset_grid": [
      "all",
      "high_conf"
    ],
    "threshold": {
      "grid": [
        0.2,
        0.25,
        0.3,
        0.35,
        0.4,
        0.45,
        0.5,
        0.55,
        0.6,
        0.65,
        0.7,
        0.75,
        0.8
      ],
      "selection": "per_label_f1_on_validation"
    },
    "tokenizer": {
      "fit_scope": "train_only",
      "level": "char",
      "max_len": 32
    },
    "type": "char_cnn"
  },
  "outputs": {
    "artifacts": [
      "model.pt",
      "tokenizer.json",
      "feature_map.json",
      "config.json",
      "metrics.json",
      "manifest.json",
      "history.json",
      "thresholds.json",
      "checkpoint_best.pt"
    ]
  },
  "seeds": {
    "model": 20261031
  }
}
